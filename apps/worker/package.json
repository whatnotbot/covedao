{
  "name": "@crclaunch/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "reindex": "tsx src/reindex.ts",
    "demo:reset": "tsx src/demo-reset.ts",
    "test:integration": "tsx src/reorg.integration.ts"
  },
  "dependencies": {
    "@crclaunch/config": "workspace:*",
    "@crclaunch/curve": "workspace:*",
    "@crclaunch/db": "workspace:*",
    "@crclaunch/protocol": "workspace:*",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}