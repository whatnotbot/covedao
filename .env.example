# ─────────────────────────────────────────────────────────────
# CRC Launch — environment configuration
# Copy to .env (never commit real secrets)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CRC Launch

# ── Core services ────────────────────────────────────────────
DATABASE_URL=postgres://crclaunch:crclaunch@localhost:5432/crclaunch
REDIS_URL=redis://localhost:6379

# ── Protocol / network ───────────────────────────────────────
# Supported execution environments: mock | test | mainnet | mainnet-read-only
CRC_NETWORK=mock
CRC_PROTOCOL_URL=
CRC_PROTOCOL_VERIFIED=false

# Mainnet safety gates (each must be true AND CRC_PROTOCOL_VERIFIED=true)
CRC_DEPLOY_MAINNET_ENABLED=false
CRC_MINT_MAINNET_ENABLED=false
CRC_MARKET_MAINNET_ENABLED=false
CRC_GRADUATION_MAINNET_ENABLED=false

# ── Bitcoin provider ─────────────────────────────────────────
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_EXPLORER_URL=https://mempool.space

# ── Platform economics ───────────────────────────────────────
PLATFORM_TREASURY_ADDRESS=
LAUNCH_FEE_SATS=10000
PRIMARY_MINT_FEE_BPS=100

# ── Finality / quote policy ──────────────────────────────────
FINALITY_CONFIRMATIONS=6
QUOTE_TTL_SECONDS=120
QUOTE_TTL_BLOCKS=2

# ── Fee protection ───────────────────────────────────────────

# ── Storage (S3-compatible) ──────────────────────────────────
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=
ADMIN_AUTH_SECRET=

# ── Cove V1 (Bitcoin) ────────────────────────────────────────
COVE_RPC_URL=https://bitcoin-signet-rpc.publicnode.com

# Cove mainnet two-stage activation (fail-closed; see docs/TRUST_MODEL.md).
# READ_ONLY: leave everything below empty/false.
#
# Consensus configuration (H, treasuryScript, settlementScript) is committed as
# IMMUTABLE LITERALS in COVE_V1_MAINNET_CONFIG (packages/protocol/src/cove/config.ts).
# Runtime env may only VERIFY against it, never define it:
#   COVE_MAINNET_TREASURY_ADDRESS  must decode to the committed treasuryScript
#   COVE_MAINNET_SETTLEMENT_ADDRESS must decode to the committed settlementScript
#   COVE_V1_MAINNET_GENESIS_HEIGHT  must equal the committed genesisHeight (H)
#
# Owner canary proof (all three lifecycle txids + matching replay roots REQUIRED):
#   COVE_V1_MAINNET_CANARY_DEPLOY_TXID
#   COVE_V1_MAINNET_CANARY_MINT_TXID
#   COVE_V1_MAINNET_CANARY_TRANSFER_TXID
#   COVE_V1_MAINNET_CANARY_STATE_ROOT   (final)
#   COVE_V1_MAINNET_CANARY_REPLAY_ROOT  (clean replay; must equal STATE_ROOT)
#   COVE_MAINNET_ENABLED=true           (OWNER_CANARY)
# PUBLIC_WRITES: only after the full canary proof is recorded, enable deploy/mint/transfer.
COVE_MAINNET_ENABLED=false
COVE_DEPLOY_MAINNET_ENABLED=false
COVE_MINT_MAINNET_ENABLED=false
COVE_TRANSFER_MAINNET_ENABLED=false
COVE_V1_MAINNET_GENESIS_HEIGHT=
COVE_V1_MAINNET_CANARY_DEPLOY_TXID=
COVE_V1_MAINNET_CANARY_MINT_TXID=
COVE_V1_MAINNET_CANARY_TRANSFER_TXID=
COVE_V1_MAINNET_CANARY_STATE_ROOT=
COVE_V1_MAINNET_CANARY_REPLAY_ROOT=
COVE_MAINNET_TREASURY_ADDRESS=
COVE_MAINNET_SETTLEMENT_ADDRESS=
COVE_MAINNET_ACTOR_ADDRESS=
COVE_MAINNET_RECIPIENT_ADDRESS=
COVE_MAINNET_RPC_URL=
COVE_MAINNET_ESPLORA_URL=

# Canary external-signing inputs (NEVER keys — signed material arrives from outside):
COVE_MAINNET_SIGNED_TX=
COVE_MAINNET_SIGNED_TX_FILE=
COVE_MAINNET_SIGNED_PSBT=
COVE_MAINNET_CANARY_TICKER=COVE
COVE_MAINNET_FEE_RATE_SATVB=5

# Local signer key files (gitignored; WIFs, mode 0600, NEVER committed/printed):
#   signet:     COVE_WIF / COVE_WIF_FILE / COVE_WIF_B / COVE_WIF_B_FILE
#   mutinynet:  COVE_MUTINYNET_WIF / COVE_MUTINYNET_WIF_FILE / COVE_MUTINYNET_WIF_B / COVE_MUTINYNET_WIF_B_FILE
COVE_WIF=
COVE_WIF_FILE=
COVE_WIF_B=
COVE_WIF_B_FILE=
COVE_MUTINYNET_WIF=
COVE_MUTINYNET_WIF_FILE=
COVE_MUTINYNET_WIF_B=
COVE_MUTINYNET_WIF_B_FILE=
COVE_MUTINYNET_ESPLORA_URL=https://mutinynet.com/api
