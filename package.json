{
  "name": "crc-launch",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@crclaunch/web",
    "dev:worker": "turbo run dev --filter=@crclaunch/worker",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=!@crclaunch/web --filter=!@crclaunch/worker",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "pnpm --filter @crclaunch/db db:generate",
    "db:migrate": "pnpm --filter @crclaunch/db db:migrate",
    "db:push": "pnpm --filter @crclaunch/db db:push",
    "db:seed": "pnpm --filter @crclaunch/db db:seed",
    "reindex": "pnpm --filter @crclaunch/worker reindex",
    "demo:reset": "pnpm --filter @crclaunch/worker demo:reset",
    "mock-crc": "pnpm --filter @crclaunch/mock-crc-service dev",
    "cove:index": "pnpm --filter @crclaunch/cove-indexer index",
    "cove:verify": "pnpm --filter @crclaunch/cove-indexer verify",
    "cove:status": "pnpm --filter @crclaunch/cove-indexer status",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:integration": "pnpm --filter @crclaunch/worker test:integration",
    "cove:worker": "pnpm --filter @crclaunch/cove-indexer worker",
    "cove:signet-proof": "pnpm --filter @crclaunch/cove-indexer signet-proof",
    "cove:mutinynet-proof": "pnpm --filter @crclaunch/cove-indexer mutinynet-proof",
    "cove:mainnet-config": "pnpm --filter @crclaunch/cove-indexer mainnet-config",
    "cove:mainnet-canary": "pnpm --filter @crclaunch/cove-indexer mainnet-canary",
    "cove:regtest-reorg": "pnpm --filter @crclaunch/cove-indexer regtest-reorg",
    "cove:liquidity-demo": "pnpm --filter @crclaunch/cove-indexer liquidity-demo",
    "cove:regtest-proof": "pnpm --filter @crclaunch/cove-guardian regtest-proof",
    "cove:v3-regtest-lifecycle": "pnpm --filter @crclaunch/cove-guardian v3-regtest-lifecycle",
    "cove:csv-proof": "pnpm --filter @crclaunch/cove-vault csv-proof"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
