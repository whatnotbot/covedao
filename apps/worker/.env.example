# Cove V3 worker (indexer + reconciliation) — deploy environment. Exactly
# these variables. The worker never calls the Guardian (only the web's mint
# and redeem submits sign), so it needs no Guardian URL or token.

# regtest | signet | testnet | mainnet. Required, no default.
COVE_NETWORK=mainnet

# Postgres shared with the web app.
COVE_DATABASE_URL=

# Bitcoin Core JSON-RPC (API key in the URL for hosted providers).
# COVE_BITCOIN_RPC_USER / COVE_BITCOIN_RPC_PASSWORD are optional.
COVE_BITCOIN_RPC_URL=

# Never set COVE_*_PRIVATE_KEY_HEX here: on mainnet the worker refuses them.
