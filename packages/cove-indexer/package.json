{
  "name": "@crclaunch/cove-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "index": "tsx src/cli.ts index",
    "verify": "tsx src/cli.ts verify",
    "status": "tsx src/cli.ts status",
    "test:integration": "tsx src/store.integration.ts",
    "worker": "tsx src/cli.ts worker"
  },
  "dependencies": {
    "@crclaunch/bitcoin": "workspace:*",
    "@crclaunch/config": "workspace:*",
    "@crclaunch/curve": "workspace:*",
    "@crclaunch/protocol": "workspace:*",
    "@crclaunch/db": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
