// Cove REDEEM (sell-to-backing) policy — Simfony source (production V3).
//
// Real Simplicity: compiled by the `simfony` crate, real CMR via rust-simplicity,
// executed on the Simplicity Bit Machine. NOT a TypeScript/Rust predicate.
//
// V3 change: u64 underflow/borrow is now enforced directly. For the supply
// subtraction the existing `le_64(amount, old_supply)` already implies no borrow;
// for the backing subtraction `le_64(payout, old_backing)` is added (the
// mathematically-equivalent no-borrow check). Underflow-shaped witness values can
// no longer satisfy the equalities. Bitcoin-introspection limitation (honest):
// tx state arrives as WITNESS values; the TS reference is the differential oracle.

fn main() {
    let amount: u64 = witness::AMOUNT;
    let old_supply: u64 = witness::OLD_SUPPLY;
    let new_supply: u64 = witness::NEW_SUPPLY;
    let old_backing: u64 = witness::OLD_BACKING;
    let new_backing: u64 = witness::NEW_BACKING;
    let payout: u64 = witness::PAYOUT;

    // Positive amount.
    assert!(jet::lt_64(0, amount));
    // No underflow: amount <= old supply.
    assert!(jet::le_64(amount, old_supply));
    // Supply conservation: new = old - amount; NO borrow.
    let (borrow, diff): (bool, u64) = jet::subtract_64(old_supply, amount);
    assert!(jet::eq_64(diff, new_supply));
    // Backing conservation: newBacking = oldBacking - payout; NO borrow.
    assert!(jet::le_64(payout, old_backing));
    let (borrow2, diff2): (bool, u64) = jet::subtract_64(old_backing, payout);
    assert!(jet::eq_64(diff2, new_backing));
}
